{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ur",
  "version": "0.1.0",
  "identifier": "dev.ur.app",
  "build": {
    "beforeDevCommand": "../scripts/build-sidecar debug && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "../scripts/build-sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ur",
        "width": 1000,
        "height": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ur"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
