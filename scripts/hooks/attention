#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import time
import uuid


def tmux(*args):
    return subprocess.run(["tmux", *args], text=True, capture_output=True)


def blocks(record):
    content = record.get("message", {}).get("content", [])
    return content if isinstance(content, list) else []


def records(stream):
    while True:
        offset = stream.tell()
        line = stream.readline()
        if not line.endswith("\n"):
            stream.seek(offset)
            return
        yield json.loads(line)


def owner(pane):
    # Claude is the pane shell's child on this hook's ancestry, or the pane process itself.
    shell = tmux("display-message", "-p", "-t", pane, "#{pane_pid}").stdout.strip()
    pid = os.getppid()
    while pid > 1:
        if str(pid) == shell:
            return pid
        parent = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)],
                                text=True, capture_output=True).stdout.strip()
        if not parent:
            return None
        if parent == shell:
            return pid
        pid = int(parent)
    return None


def watch(pane, token, stream, event, tool_id, claude):
    while tmux("display-message", "-p", "-t", pane, "#{@agent-request}").stdout.strip() == token:
        if claude:
            try:
                os.kill(claude, 0)
            except ProcessLookupError:
                return
        for record in records(stream):
            for block in blocks(record):
                if tool_id is None and matches(block, event):
                    tool_id = block["id"]
            if tool_id and any(b.get("type") == "tool_result" and b.get("tool_use_id") == tool_id
                               for b in blocks(record)):
                # Check and clear in tmux's command queue, so an old result cannot
                # acknowledge a newer request or a completion/error mark.
                tmux("if-shell", "-t", pane, "-F", f"#{{==:#{{@agent-request}},{token}}}",
                     f'set -p -t {pane} @agent-attention "" ; set -p -t {pane} @agent-request ""')
                return
        time.sleep(0.2)


def matches(block, event):
    return (block.get("type") == "tool_use" and block.get("name") == event["tool_name"]
            and block.get("input") == event.get("tool_input"))


def follow_permission(event, pane, token):
    if not event.get("transcript_path") or not event.get("tool_name"):
        return
    with open(event["transcript_path"]) as transcript:
        pending = {}
        for record in records(transcript):
            for block in blocks(record):
                if matches(block, event):
                    pending[block["id"]] = None
                elif block.get("type") == "tool_result":
                    pending.pop(block.get("tool_use_id"), None)
        # Claude can flush the tool call after this hook returns. Follow from
        # this offset even when its tool_use record has not reached disk yet.
        child = subprocess.Popen(
            [sys.executable, __file__, "claude", "watch", token, str(transcript.fileno())],
            stdin=subprocess.PIPE, pass_fds=(transcript.fileno(),),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        child.stdin.write(json.dumps({"event": event, "tool_id": next(reversed(pending), None),
                                      "owner": owner(pane)}).encode())
        child.stdin.close()


def main():
    pane = os.environ.get("TMUX_PANE")
    if not pane or not os.environ.get("TMUX"):
        return
    agent, state = sys.argv[1:3]
    if state == "watch":
        request = json.load(sys.stdin)
        with os.fdopen(int(sys.argv[4])) as transcript:
            watch(pane, sys.argv[3], transcript, request["event"], request["tool_id"],
                  request["owner"])
        return
    event = json.load(sys.stdin)
    if event.get("agent_id"):
        return
    if state in ("finished", "error"):
        focused = tmux("display-message", "-p", "-t", pane, "#{@ur-focused}")
        if focused.stdout.strip() == "1":
            state = "clear"
    token = uuid.uuid4().hex if state == "permission" else ""
    tmux("set-option", "-p", "-t", pane, "@agent-request", token, ";",
         "set-option", "-p", "-t", pane, "@agent-attention", "" if state == "clear" else state)
    # Only Claude transcripts are followed. Codex clears requests with its tool and turn hooks.
    if state == "permission" and agent == "claude":
        follow_permission(event, pane, token)


if __name__ == "__main__":
    main()
