#!/bin/sh
set -eu
cd "$(dirname "$0")/.."

profile="${UR_SIDECAR_PROFILE:-${1:-release}}"
host="$(rustc --print host-tuple)"
target="${TAURI_ENV_TARGET_TRIPLE:-$host}"
case "$profile" in
  debug) flags="" ;;
  release) flags="--release" ;;
  *) echo "unknown sidecar profile: $profile" >&2; exit 1 ;;
esac

# A host build shares `target/<profile>` with the rest of the workspace instead
# of building every dependency again under `target/<triple>`.
target_dir="${CARGO_TARGET_DIR:-target}"
if [ "$target" = "$host" ]; then
  cargo build -p ur $flags
  out="$target_dir/$profile/ur"
else
  cargo build -p ur $flags --target "$target"
  out="$target_dir/$target/$profile/ur"
fi
mkdir -p app/src-tauri/binaries
cp "$out" "app/src-tauri/binaries/ur-$target"
