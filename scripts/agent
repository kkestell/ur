#!/usr/bin/env python3
import json
import os
from pathlib import Path
import shutil
import sys


def toml(value):
    if isinstance(value, dict):
        return "{" + ", ".join(f"{key} = {toml(item)}" for key, item in value.items()) + "}"
    if isinstance(value, list):
        return "[" + ", ".join(map(toml, value)) + "]"
    return json.dumps(value, ensure_ascii=False)


agent, settings = sys.argv[1:3]
bin_dir = Path(settings).parent.parent / "bin"
search_path = os.pathsep.join(
    entry for entry in os.get_exec_path() if Path(entry).resolve() != bin_dir.resolve()
)
executable = shutil.which(agent, path=search_path)
if executable is None:
    sys.exit(f"ur: {agent} is not on PATH")

if agent == "claude":
    args = ["--settings", settings]
elif agent == "opencode":
    args = []
    content = json.loads(os.environ.get("OPENCODE_CONFIG_CONTENT") or "{}")
    plugins = json.loads(Path(settings).read_text())["plugin"]
    content["plugin"] = [*content.get("plugin", []), *plugins]
    os.environ["OPENCODE_CONFIG_CONTENT"] = json.dumps(content)
else:
    hooks = json.loads(Path(settings).read_text())["hooks"]
    args = ["-c", "hooks=" + toml(hooks)]
os.execv(executable, [agent, *args, *sys.argv[3:]])
